# Copy this file to .env. Never commit the populated .env file.
APP_ENV=development
GROQ_API_KEY=

# Models
INTENT_MODEL=openai/gpt-oss-20b
EXPLANATION_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=qwen/qwen3-27b

# Data paths (dataset/ is gitignored for CSVs; DuckDB written there too)
DATA_DIR=dataset
DB_PATH=dataset/aml.duckdb
CSV_PATH=dataset/HI-Small_Trans.csv
ACCOUNTS_CSV_PATH=dataset/HI-Small_accounts.csv
SAML_D_PATH=dataset/SAML-D.csv
UPLOAD_DIR=dataset/uploads
MAX_UPLOAD_BYTES=5368709120
MAX_QUERY_ROWS=100000

# API settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (React dev server proxied to API)
VITE_API_BASE_URL=/api

# AML policy defaults. Production changes require compliance approval.
RISK_LOW_THRESHOLD=0.35
RISK_HIGH_THRESHOLD=0.70
CTR_THRESHOLD=10000
STRUCTURING_WINDOW_DAYS=3
STRUCTURING_MIN_TXNS=3

# AWS deployment. Change to false for local DuckDB mode. IAM roles supply credentials.
# Set all three resource identifiers before enabling AWS mode.
AWS_ENABLED=true
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_DYNAMODB_TABLE=SentinelInvestigations
AWS_SNS_TOPIC_ARN=
AWS_MAX_DATASET_BYTES=52428800
